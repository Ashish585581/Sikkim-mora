# Sikkim Mora - Environment Configuration Template
# Copy this file to .env and replace placeholder values with verified contact details

# Business Phone Number
VITE_PHONE_NUMBER=+919876543210
VITE_PHONE_DISPLAY=+91 98765 43210

# WhatsApp Dispatch Number (Country code without leading + or spaces, e.g. 919876543210)
VITE_WHATSAPP_NUMBER=919876543210
VITE_WHATSAPP_DISPLAY=+91 98765 43210

# Corporate Support Email
VITE_EMAIL=info@example.com

# Production Domain / Site URL
VITE_SITE_URL=https://sikkimora.com
